# The raw retrievals. Never in git: the DINS file is 132,000 rows of structure-level
# records at their published coordinates, and this repository publishes counts.
data/raw/
build/
.venv/
__pycache__/
*.pyc
.coverage
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Claude Code's working directory, including the git worktrees it creates for
# agents. A tool's scratch space is not the repository, which is why build/ and the
# cache directories above are here too.
.claude/

# The two page-checking toolchains. Both are locked (package-lock.json and
# tools/a11y_browser/package-lock.json are tracked) and installed by `make node-sync`
# and `make browser-sync`; the trees themselves are not the repository.
node_modules/
tools/a11y_browser/test-results/
tools/a11y_browser/playwright-report/
